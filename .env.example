# --- Application ---
PROJECT_NAME="Corman PMT"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database ---
# Use 127.0.0.1 rather than localhost: on Windows, localhost resolves to ::1 and
# Docker Desktop's IPv6 port proxy hangs on the connection.
DATABASE_URL=postgresql+asyncpg://corman:corman@127.0.0.1:55432/corman_pmt

# --- CORS ---
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300
